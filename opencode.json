{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
  	"openrouter": {
		"options": {
			"apiKey": "{file:./.secrets/openrouter-key}"
		}
	}
  },

  "default_agent": "orchestrator",

  "agent": {
    "orchestrator": {
    	"mode": "primary",
	"permission": {
		"task": {
			"*": "deny",
			"architect": "allow",
			"implementer": "allow",
			"reviewer": "allow",
			"scout": "allow"
		}
	}
    },
	"architect": {
      "description": "Designs solutions and creates implementation plans",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/architect.md}",
      "permission": {
        "edit": {
		"*":"deny",
		"IMPLEMENTATION_PLAN.md":"allow"
	},
        "bash": "deny"
      }
    },

    "implementer": {
      "description": "Implements approved plans and runs tests",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/implementer.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },

    "reviewer": {
      "description": "Independently reviews changes for bugs and design problems",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/reviewer.md}",
      "permission": {
        "edit": "deny"
      }
    },

    "scout": {
      "description": "Quickly explores and summarizes the repository",
      "mode": "subagent",
      "model": "openrouter/z-ai/glm-5.2",
      "prompt": "{file:./prompts/scout.md}",
      "permission": {
        "edit": "deny"
      }
    }
  }
}
