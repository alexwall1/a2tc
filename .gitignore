# The LLM provider's key — never commit it
api-key.txt

# Key files of the tool's earlier provider
.openrouter_key

# Sample legislation. Proposals and consolidated acts are public documents on
# EUR-Lex; they are large, they are not ours, and the tests skip cleanly without
# them. Fetch what you need locally instead of committing it.
*.pdf

# Generated output: tracked-changes documents, reports, retrieval and LLM caches
/out*/
*.docx

# Web app runtime data: user uploads and job directories
/webapp-data/

# Local secrets: web-app user/admin passwords (and opencode's own key)
.secrets/

# Working notes. Development scratch, not part of the delivered project.
/PHASE0.md
/PLAN.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Local Claude Code settings (shared config belongs in .claude/settings.json)
.claude/settings.local.json
.claude/settings.local.json.tmp.*

# Editors and OS
.idea/
.vscode/
.DS_Store
