*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Local Claude Code settings (shared config belongs in .claude/settings.json)
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/
.DS_Store
