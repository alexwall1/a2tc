# Secrets — the LLM tier reads this file from the project root
.openrouter_key

# Sample legislation. Proposals and consolidated acts are public documents on
# EUR-Lex; they are large, they are not ours, and the tests skip cleanly without
# them. Fetch what you need locally instead of committing it.
*.pdf

# Generated output: tracked-changes documents, reports, retrieval and LLM caches
/out*/
*.docx

